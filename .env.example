# Google Gemini API Key (obtain from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Qdrant Vector Database URL (e.g., http://localhost:6333 for local instance, or Qdrant Cloud cluster URL)
QDRANT_URL=http://localhost:6333

# Qdrant API Key (leave empty or provide token if connecting to Qdrant Cloud / secured cluster)
QDRANT_API_KEY=your_qdrant_api_key_here
